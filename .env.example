# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=escrow
POSTGRES_PASSWORD=escrowpass
POSTGRES_DB=escrowdb
DATABASE_URL="postgresql://escrow:escrowpass@localhost:5432/escrowdb?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://:redispass@localhost:6379"
REDIS_PASSWORD=redispass

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-at-least-64-chars"
JWT_REFRESH_SECRET="change-me-another-long-random-string-64-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Africa's Talking (SMS / OTP) ─────────────────────────────────────────────
AFRICAS_TALKING_API_KEY="your_africastalking_api_key"
AFRICAS_TALKING_USERNAME="sandbox"        # use "sandbox" for testing
AFRICAS_TALKING_SENDER_ID="ESCROW255"

# ─── Selcom (Mobile Money — Sandbox) ─────────────────────────────────────────
SELCOM_API_KEY="your_selcom_api_key"
SELCOM_API_SECRET="your_selcom_api_secret"
SELCOM_VENDOR_ID="your_selcom_vendor_id"
SELCOM_BASE_URL="https://apigw.selcommobile.com/v1"

# ─── AWS S3 (File Storage) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="escrow255-uploads"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── Misc ─────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
INSPECTION_WINDOW_HOURS=48
DISPUTE_FAST_TRACK_FEE_TZS=5000
PLATFORM_FEE_PERCENT=2.5
